# dependencies
node_modules/
.pnp
.pnp.js

# next / build
.next/
out/
build/
dist/
.vinext/
.open-next/

# cloudflare
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# env / secrets  — never commit real values
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# Scratch output from source investigation; never part of the app.
conf_diag.txt
ibm_*.txt
jobsyn*.txt
cheq*.txt
dejobs*.txt
apple_*.txt

# Raw email samples. LinkedIn alert mail is personal correspondence -- it carries Sarthak's
# name, tracking ids tied to his account, and whatever else LinkedIn chose to put in it.
# Test fixtures are scrubbed copies under crawler/tests/, never the original.
*.eml
# ...but the scrubbed fixtures are the test suite's ground truth and must be committed.
!crawler/tests/fixtures/**/*.eml

# Book PDFs. Paid copies belong to whoever bought them, not in a repository.
app/public/books/*.pdf

# Secret bundles from scripts/export_secrets.py, in case one is ever written into the repo.
job-search-os-secrets-*.zip

# The MCP server gets its own virtualenv, so the protocol SDK and its pydantic floor stay
# out of the crawler environment the crawl depends on.
mcp/.venv/
