# Copy to .env and fill in. NEVER commit the real .env.

# Shared secret between the app and the crawler. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_TOKEN=""

# The deployed Worker URL, or http://localhost:3000 for local development.
APP_BASE_URL=""

# Cloudflare: dash.cloudflare.com -> My Profile -> API Tokens ("Edit Cloudflare Workers")
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudflare Access service token: Zero Trust -> Access -> Service Auth
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# Gmail app password: Google Account -> Security -> 2-Step Verification -> App passwords
# (requires 2FA; paste the 16 characters without spaces)
SMTP_USER=""
SMTP_APP_PASSWORD=""
NOTIFY_EMAIL=""
